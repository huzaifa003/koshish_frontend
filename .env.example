# Hosted Supabase project URL and publishable key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Never prefix this with NEXT_PUBLIC_. Used for contact/volunteer submissions.
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_secret_key
# Optional Cloudflare Turnstile protection for public forms (configure both).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
